# ── Database ─────────────────────────────────────────────────
# Render provides this automatically via the DATABASE_URL env var
DATABASE_URL=postgresql://user:password@host:5432/eafc_league

# ── Auth ─────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-here
JWT_EXPIRES_IN=8h

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Owner account (created on first startup if no users exist) ─
OWNER_USERNAME=tyron
OWNER_PASSWORD=change-this-password
OWNER_DISPLAY_NAME=Tyron (Owner)

# ── Optional: CORS origin for your frontend domain ────────────
# CORS_ORIGIN=https://your-app.onrender.com
